# ====== Telegram 推送配置(必填) ======
# 找 @BotFather 创建机器人获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 推送目标 chat_id:
#   - 个人: 给机器人发一条消息,访问 https://api.telegram.org/bot<TOKEN>/getUpdates 获取
#   - 群组: 把机器人拉进群,发一条消息,getUpdates 里 chat.id 通常是负数
TELEGRAM_CHAT_ID=your_chat_id_here

# ====== LLM 摘要配置(必填) ======
# 推荐使用兼容 OpenAI 协议的 API(MiniMax / OpenAI / DeepSeek / 智谱GLM 都可以)
# 如果用 MiniMax,申请地址: https://platform.MiniMax.cn/
LLM_API_BASE=https://api.MiniMax.cn/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=MiniMax-Text-01
# 单次推送预算(防止爆 token),默认 500
LLM_MAX_ARTICLES=80

# ====== 运行参数(可选) ======
# 抓取多少小时内的文章,默认 24
LOOKBACK_HOURS=24
# 每源最多取多少篇,默认 8
MAX_PER_SOURCE=8
# Telegram 单条消息最大长度 4096 字符,单批发送条数(防止刷屏)
TELEGRAM_BATCH_SIZE=12
